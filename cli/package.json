{
  "name": "create-expo-boilerplate",
  "version": "0.1.0",
  "description": "Create a production-ready Expo and React Native app in one command: Expo Router or React Navigation, Zustand or Redux Toolkit, Unistyles, StyleSheet or Tailwind, TypeScript or JavaScript.",
  "type": "module",
  "bin": {
    "create-expo-boilerplate": "dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "overlays"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync-template": "node scripts/sync-template.mjs",
    "prepack": "npm run build && npm run sync-template",
    "test:matrix": "node scripts/test-matrix.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EndLess728/react-native-expo-boilerplate.git",
    "directory": "cli"
  },
  "homepage": "https://endless728.github.io/react-native-expo-boilerplate/",
  "bugs": {
    "url": "https://github.com/EndLess728/react-native-expo-boilerplate/issues"
  },
  "keywords": [
    "expo",
    "react-native",
    "boilerplate",
    "starter",
    "template",
    "create",
    "create-expo-app",
    "expo-router",
    "react-navigation",
    "zustand",
    "redux-toolkit",
    "tanstack-query",
    "unistyles",
    "tailwind",
    "uniwind",
    "typescript",
    "mmkv",
    "i18n",
    "eas"
  ],
  "author": "EndLess728",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.7.4",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
